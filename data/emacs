#!/bin/sh

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT=$(realpath $SCRIPT_DIR/docker/usr/local)
VERSION=$(basename $(ls $ROOT/libexec/emacs/ | head -1))

export EMACSDATA="$ROOT/share/emacs/$VERSION/etc"
export EMACSDOC="$ROOT/share/emacs/$VERSION/etc"
export EMACSPATH="$ROOT/libexec/emacs/$VERSION/x86_64-pc-linux-gnu:$ROOT/share/emacs/$VERSION/etc"
export EMACSLOADPATH="$ROOT/share/emacs/$VERSION/lisp:$ROOT/share/emacs/$VERSION/site-lisp"

$ROOT/bin/emacs-$VERSION "$@"
